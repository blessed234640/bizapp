# Database
DATABASE_URL=postgresql://user:password@db:5432/bizapp

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
JWT_SECRET_KEY=generate-with-python-secrets-token-hex-32
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:5173,http://web:8080

# Django
DJANGO_SECRET_KEY=change-me-django-secret-key

# GigaChat (AI) — авторизационный ключ (Basic), см. https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_AUTH_KEY=your-gigachat-authorization-key
